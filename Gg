#include <stdio.h>

void insert(float a[], int *n, float x) {
    int i;
    for (i = *n - 1; i >= 0 && a[i] > x; i--) {
        a[i + 1] = a[i];
    }
    a[i + 1] = x;
    (*n)++;
}

void printArray(float a[], int n) {
    printf("{");
    for (int i = 0; i < n; i++) {
        printf("%.2f", a[i]);
        if (i < n - 1) printf(", ");
    }
    printf("}\n");
}

int main() {
    float a[10] = {11.11, 22.22, 33.33, 44.44, 55.55};
    int n = 5;
    float x = 38.38;

    printf("Before insertion (n=%d): ", n);
    printArray(a, n);

    insert(a, &n, x);

    printf("After inserting %.2f (n=%d): ", x, n);
    printArray(a, n);

    return 0;
}
