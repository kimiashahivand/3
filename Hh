#include <stdio.h>

int frequency(float a[], int n, float x) {
    int count = 0;
    for (int i = 0; i < n; i++) {
        if (a[i] == x) {
            count++;
        }
    }
    return count;
}

int main() {
    float a[] = {11.11, 22.22, 33.33, 22.22, 44.44, 22.22, 55.55};
    int n = 7;
    float x = 22.22;

    printf("Array: ");
    for (int i = 0; i < n; i++) {
        printf("%.2f ", a[i]);
    }
    printf("\n");

    int freq = frequency(a, n, x);
    printf("Frequency of %.2f: %d times\n", x, freq);

    x = 99.99;
    freq = frequency(a, n, x);
    printf("Frequency of %.2f: %d times\n", x, freq);

    return 0;
}
