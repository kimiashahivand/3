#include <stdio.h>

void removeAll(float a[], int *n, float x) {
    int i = 0;
    while (i < *n) {
        if (a[i] == x) {
          
            for (int j = i; j < *n - 1; j++) {
                a[j] = a[j + 1];
            }
            (*n)--;
            
        } else {
            i++;
        }
    }
}

int main() {
    float a[10] = {11.11, 33.33, 55.55, 77.77, 55.55, 99.99, 55.55, 22.22, 55.55, 88.88};
    int n = 10;
    float x = 55.55;

    printf("Original array (%d elements):\n", n);
    for (int i = 0; i < n; i++) {
        printf("a[%d] = %.2f\n", i, a[i]);
    }

    removeAll(a, &n, x);

    printf("\nAfter removing all %.2f (%d elements):\n", x, n);
    for (int i = 0; i < n; i++) {
        printf("a[%d] = %.2f\n", i, a[i]);
    }

    printf("\nNumber of elements removed: %d\n", 10 - n);

    return 0;
}
