#include <stdio.h>

void append(int a[], int m, int b[], int n) {
    for (int i = 0; i < n; i++) {
        a[m + i] = b[i];
    }
}

void printFullArray(int a[], int size, int capacity) {
    printf("a[%d] (capacity %d): {", size, capacity);
    for (int i = 0; i < size; i++) {
        printf("%d", a[i]);
        if (i < size - 1) printf(", ");
    }
    printf("}");
    

    if (size < capacity) {
        printf(" + %d unused positions", capacity - size);
    }
    printf("\n");
}

int main() {
    int a[10] = {22, 33, 44, 55, 66, 77, 88, 99};
    int b[] = {20, 30, 40, 50, 60, 70, 80};
    int m = 5, n = 3;

    printf("Before append:\n");
    printf("First %d elements of a: ", m);
    for (int i = 0; i < m; i++) printf("%d ", a[i]);
    printf("\n");

    append(a, m, b, n);

    printf("\nAfter append:\n");
    printf("All %d elements of a: ", m + n);
    for (int i = 0; i < m + n; i++) printf("%d ", a[i]);
    printf("\n");

    return 0;
}
