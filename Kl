#include <stdio.h>

void getExtremes(float *min, float *max, float a[], int n) {
    *min = a[0];
    *max = a[0];
    for (int i = 1; i < n; i++) {
        if (a[i] < *min) *min = a[i];
        if (a[i] > *max) *max = a[i];
    }
}

int main() {
    float a[5];
    float minVal, maxVal;

    printf("Enter 5 numbers:\n");
    for (int i = 0; i < 5; i++) {
        printf("a[%d] : ", i);
        scanf("%f", &a[i]);
    }

    getExtremes(&minVal, &maxVal, a, 5);
    printf("Minimum = %.2f, Maximum = %.2f\n", minVal, maxVal);
    return 0;
}
