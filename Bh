#include <stdio.h>

int minIndex(float a[], int n) {
    int minIdx = 0;
    for (int i = 1; i < n; i++) {
        if (a[i] < a[minIdx]) {
            minIdx = i;
        }
    }
    return minIdx;
}

int main() {
    float a[5];
    printf("Enter 5 numbers:\n");
    for (int i = 0; i < 5; i++) {
        printf("a[%d] : ", i);
        scanf("%f", &a[i]);
    }

    int idx = minIndex(a, 5);
    printf("Index of first minimum = %d (value = %.2f)\n", idx, a[idx]);
    return 0;
}
