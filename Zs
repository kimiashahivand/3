#include <stdio.h>

void removeElement(float a[], int *n, int i) {
    if (i < 0 || i >= *n) {
        printf("Invalid index!\n");
        return;
    }

    for (int j = i; j < *n - 1; j++) {
        a[j] = a[j + 1];
    }
    (*n)--;
}

int main() {
    float a[10] = {11.11, 33.33, 55.55, 77.77, 99.99};
    int n = 5;

    printf("Original array:\n");
    for (int i = 0; i < n; i++) {
        printf("a[%d] = %.2f\n", i, a[i]);
    }

    removeElement(a, &n, 2);

    printf("\nAfter removing index 2:\n");
    for (int i = 0; i < n; i++) {
        printf("a[%d] = %.2f\n", i, a[i]);
    }

    return 0;
}
