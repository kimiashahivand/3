#include <stdio.h>

int find_last(int a[], int n, int target) {
    for (int i = n - 1; i >= 0; i--) {
        if (a[i] == target) {
            return i;
        }
    }
    return -1; // عنصر پیدا نشد
}

int main() {
    int a[5];
    int target, i;

    printf("Enter 5 numbers\n");
    for (i = 0; i < 5; i++) {
        printf("a[%d] : ", i);
        scanf("%d", &a[i]);
    }

    printf("Enter number to find: ");
    scanf("%d", &target);

    int index = find_last(a, 5, target);
    if (index != -1) {
        printf("Last occurrence of %d is at index %d\n", target, index);
    } else {
        printf("%d not found in the array\n", target);
    }

    return 0;
}
