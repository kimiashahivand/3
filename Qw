#include <stdio.h>

int main() {
    float a[5];
    int i;

    printf("Enter 5 numbers\n");
    for (i = 0; i < 5; i++) {
        printf("a[%d] : ", i);
        scanf("%f", &a[i]);
    }

    printf("\nAddress and value of each element:\n");
    for (i = 0; i < 5; i++) {
        printf("Address of a[%d] = %p, Value = %.2f\n", i, (void*)&a[i], a[i]);
    }

    return 0;
}
