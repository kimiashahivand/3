#include <stdio.h>

int main() {
    float a[5];
    float sum = 0;
    int i;

    printf("Enter 5 numbers\n");
    for (i = 0; i < 5; i++) {
        printf("a[%d] : ", i);
        scanf("%f", &a[i]);
        sum += a[i];
    }

    printf("\nArray elements:\n");
    for (i = 0; i < 5; i++) {
        printf("a[%d] = %.2f\n", i, a[i]);
    }

    printf("\nSum = %.2f\n", sum);
    printf("Average = %.2f\n", sum / 5);

    return 0;
}
