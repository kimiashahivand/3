#include <stdio.h>

void largest(float *max1, float *max2, float a[], int n) {
    *max1 = a[0];
    *max2 = a[0];

    for (int i = 1; i < n; i++) {
        if (a[i] > *max1) {
            *max2 = *max1;
            *max1 = a[i];
        } else if (a[i] > *max2) {
            *max2 = a[i];
        }
    }
}

int main() {
    float a[5];
    float max1, max2;

    printf("Enter 5 numbers:\n");
    for (int i = 0; i < 5; i++) {
        printf("a[%d] : ", i);
        scanf("%f", &a[i]);
    }

    largest(&max1, &max2, a, 5);
    printf("Largest = %.2f, Second largest = %.2f\n", max1, max2);
    return 0;
}
