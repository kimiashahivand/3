#include <stdio.h>

float min(float a[], int n) {
    float minVal = a[0];
    for (int i = 1; i < n; i++) {
        if (a[i] < minVal) {
            minVal = a[i];
        }
    }
    return minVal;
}

int main() {
    float a[5];
    printf("Enter 5 numbers:\n");
    for (int i = 0; i < 5; i++) {
        printf("a[%d] : ", i);
        scanf("%f", &a[i]);
    }

    printf("Minimum value = %.2f\n", min(a, 5));
    return 0;
}
