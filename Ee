#include <stdio.h>
#include <stdbool.h>

bool removeFirst(float a[], int *n, float x) {
    for (int i = 0; i < *n; i++) {
        if (a[i] == x) {
        
            for (int j = i; j < *n - 1; j++) {
                a[j] = a[j + 1];
            }
            (*n)--;
            return true;
        }
    }
    return false;
}

int main() {
    float a[10] = {11.11, 33.33, 55.55, 77.77, 99.99};
    int n = 5;
    float x = 55.55;

    printf("Original array:\n");
    for (int i = 0; i < n; i++) {
        printf("a[%d] = %.2f\n", i, a[i]);
    }

    if (removeFirst(a, &n, x)) {
        printf("\nElement %.2f removed successfully.\n", x);
    } else {
        printf("\nElement %.2f not found.\n", x);
    }

    printf("\nArray after removal:\n");
    for (int i = 0; i < n; i++) {
        printf("a[%d] = %.2f\n", i, a[i]);
    }

    return 0;
}
