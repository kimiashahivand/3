#include <stdio.h>

void reverse(int a[], int n) {
    int temp;
    for (int i = 0; i < n / 2; i++) {
        temp = a[i];
        a[i] = a[n - 1 - i];
        a[n - 1 - i] = temp;
    }
}

void printArray(int a[], int n) {
    printf("{");
    for (int i = 0; i < n; i++) {
        printf("%d", a[i]);
        if (i < n - 1) printf(", ");
    }
    printf("}\n");
}

int main() {
    int a[] = {22, 33, 44, 55, 66};
    int n = 5;

    printf("Before reverse: ");
    printArray(a, n);

    reverse(a, n);

    printf("After reverse:  ");
    printArray(a, n);

    return 0;
}
